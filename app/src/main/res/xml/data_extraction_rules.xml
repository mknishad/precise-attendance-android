<?xml version="1.0" encoding="utf-8"?>
<!--
    The office location and last attendance time are local to this device, so none of the app's
    files (including the DataStore in files/datastore) are copied to cloud backup or to a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
