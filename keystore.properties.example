# Copy to keystore.properties (gitignored) and fill in. Never commit real values or the keystore.
# Alternatively set the environment variables RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD,
# RELEASE_KEY_ALIAS and RELEASE_KEY_PASSWORD. If none are set, the release build is signed with the
# debug key and logs a warning.
storeFile=/absolute/path/to/your-release-keystore.jks
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
